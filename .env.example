# ShopMock lab secrets — FAKE values for a local attack-lab. Do not reuse anywhere.
# Copy to .env:  cp .env.example .env

# Postgres superuser (all four DBs share this lab password)
PG_SUPERUSER_PASSWORD=shopmock_pg_super

# OpenSearch (search service) admin
OPENSEARCH_ADMIN_PASSWORD=ShopMockAdmin123!

# Keycloak (identity) bootstrap admin — reach via bastion only
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=ChangeMe-KC!

# Vault dev-mode root token
VAULT_ROOT_TOKEN=lab-root-token

# FreeIPA — Tier-0 control plane (the AD-equivalent DC: LDAP + Kerberos + PKI/CA).
# IPA_DM_PASSWORD is the 389DS Directory Manager (super-cred); IPA_ADMIN_PASSWORD is the
# Kerberos `admin` principal. IPA_LDAP_BIND_PASSWORD is a dedicated read-only account
# Keycloak binds with to federate employees. All fake lab values.
IPA_REALM=SHOPMOCK.LAB
IPA_DOMAIN=shopmock.lab
IPA_ADMIN_PASSWORD=ChangeMe-IPAadmin1!
IPA_DM_PASSWORD=ChangeMe-IPAdirmgr1!
IPA_LDAP_BIND_PASSWORD=ChangeMe-IPAbind1!
# Lab workforce identities. Each is a job function with exactly one application:
# it.ops -> /oe, finance.clerk -> /finance, hr.specialist -> /hr. None of these
# passwords may be committed. seed/ipa/bootstrap.sh creates a user only if it is
# missing, so changing a value here does NOT rotate an identity that already
# exists in the directory — use `ipa passwd <login>` on the DC for that.
IPA_IT_PASSWORD=ChangeMe-ITops1!
IPA_FINANCE_PASSWORD=ChangeMe-Finance1!
IPA_HR_PASSWORD=ChangeMe-HRspec1!

# PAW / jump host (access plane) — break-glass local account; primary auth is IPA/Kerberos
BASTION_USER=jump
BASTION_PASSWORD=ChangeMe-Bastion!

# PostgREST JWT verification — RS256 public JWK matching the realm signing key in
# seed/identity/realm-shopmock.json. Order/Checkout/Customer services verify Keycloak
# tokens against this. No kid, so it validates whatever kid Keycloak stamps.
PGRST_JWT_SECRET='{"kty":"RSA","alg":"RS256","use":"sig","n":"vNZGiVQZQXTDax0-_8QMfypl8vB-ox18g_KL2hGGcJpx3Dj1mCDkuE_lMcy67rwkkWvESBNQXOJtKMAd1T8FDNMIKTlGXvVEaiCagpxkpehS2-pQiLIO1Wgez7GVy3mOgds-IysWrwEZOeb_VuOOx6buZOgeOyozeG9EWlABPWXxwku1ES0T3iwF92cyqOdCViztSdaYa8po1EJ0qeTPKly2oZsOFE41_UDB2W1_fNGc9PbXpBIneXzp1vZezhqpV8wtD62OujRLquY_cpmyOFrru1K33qhvlUR5h7TM3vvr-uZAamZdHV5o2ntofXdbzn-o7-exAqxM_fiVvZOfzw","e":"AQAB"}'

# internal-service-backend (Django) — signing key + its dedicated Postgres role
DJANGO_SECRET_KEY=change-me-django-secret
INTERNAL_BACKEND_DB_PASSWORD=change-me-internal-backend-pw

# seller-backend (Django) — its dedicated Postgres role (catalog + orders DBs)
SELLER_BACKEND_DB_PASSWORD=change-me-seller-backend-pw

# OE dashboard (container health + DB overview) — HTTP basic auth at /oe
OE_USERNAME=oe-admin
OE_PASSWORD=ChangeMe-OE!

# finance-portal (Django, /finance) — its dedicated read-only Postgres role on
# finance-db. Column-level SELECT that excludes finance.payment_methods.token.
FINANCE_PORTAL_DB_PASSWORD=change-me-finance-portal-pw

# hr-portal (Django, /hr) — its dedicated read-only Postgres role on the
# isolated hr-db. This service has no credential for any other database.
HR_PORTAL_DB_PASSWORD=change-me-hr-portal-pw

# Browser-visible storefront origin. scripts/deploy.sh applies this exact
# origin to the Keycloak storefront and seller clients after every deploy.
# Override per environment (for example, https://shopmock.example.com).
PUBLIC_ORIGIN=http://localhost
