{
  "realm": "shopmock-workforce",
  "enabled": true,
  "displayName": "ShopMock Workforce Identity",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Internal staff (HR/Finance/Legal/IT)"
      },
      {
        "name": "global-admin",
        "description": "Tier 0 global administrator"
      },
      {
        "name": "it-ops",
        "description": "Internal IT operations — container health console (/oe)"
      },
      {
        "name": "finance",
        "description": "Finance — revenue and settlement portal (/finance)"
      },
      {
        "name": "hr",
        "description": "People operations — staff directory portal (/hr)"
      }
    ]
  },
  "groups": [
    {
      "name": "workforce",
      "subGroups": [
        {
          "name": "employees",
          "realmRoles": [
            "employee"
          ]
        },
        {
          "name": "tier0-admins",
          "realmRoles": [
            "global-admin"
          ]
        },
        {
          "name": "it-ops",
          "realmRoles": [
            "it-ops"
          ]
        },
        {
          "name": "finance",
          "realmRoles": [
            "finance"
          ]
        },
        {
          "name": "hr",
          "realmRoles": [
            "hr"
          ]
        },
        {
          "name": "server-admins"
        },
        {
          "name": "helpdesk"
        },
        {
          "name": "ipausers"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "it-operations",
      "description": "IT operations console (/oe) — authorization code + PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/oe/",
        "http://localhost/oe/*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "internal-services",
      "enabled": true,
      "publicClient": false,
      "secret": "lab-internal-client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "finance-portal",
      "description": "Finance portal (/finance) — authorization code + PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/finance/",
        "http://localhost/finance/*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "hr-portal",
      "description": "People operations portal (/hr) — authorization code + PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/hr/",
        "http://localhost/hr/*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [],
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": false,
  "defaultGroups": [],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "freeipa",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "uid"
                ],
                "user.model.attribute": [
                  "username"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "givenName"
                ],
                "user.model.attribute": [
                  "firstName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "sn"
                ],
                "user.model.attribute": [
                  "lastName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": [
                  "mail"
                ],
                "user.model.attribute": [
                  "email"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "freeipa groups",
              "providerId": "group-ldap-mapper",
              "subComponents": {},
              "config": {
                "groups.dn": [
                  "cn=groups,cn=accounts,dc=shopmock,dc=lab"
                ],
                "group.name.ldap.attribute": [
                  "cn"
                ],
                "group.object.classes": [
                  "groupOfNames"
                ],
                "preserve.group.inheritance": [
                  "false"
                ],
                "ignore.missing.groups": [
                  "true"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "groups.ldap.filter": [
                  "(|(cn=employees)(cn=tier0-admins)(cn=server-admins)(cn=helpdesk)(cn=it-ops)(cn=finance)(cn=hr))"
                ],
                "mode": [
                  "READ_ONLY"
                ],
                "user.roles.retrieve.strategy": [
                  "GET_GROUPS_FROM_USER_MEMBEROF_ATTRIBUTE"
                ],
                "memberof.ldap.attribute": [
                  "memberOf"
                ],
                "drop.non.existing.groups.during.sync": [
                  "false"
                ]
              }
            }
          ]
        },
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "1"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "vendor": [
            "rhds"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "ipaUniqueID"
          ],
          "userObjectClasses": [
            "inetOrgPerson, organizationalPerson"
          ],
          "connectionUrl": [
            "ldap://ipa.shopmock.lab:389"
          ],
          "usersDn": [
            "cn=users,cn=accounts,dc=shopmock,dc=lab"
          ],
          "bindDn": [
            "uid=keycloak-federation,cn=sysaccounts,cn=etc,dc=shopmock,dc=lab"
          ],
          "searchScope": [
            "1"
          ],
          "pagination": [
            "true"
          ],
          "connectionPooling": [
            "true"
          ]
        }
      }
    ],
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "shopmock-rsa",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "1000"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_REALM_SIGNING_KEY}"
          ],
          "certificate": [
            "${KC_REALM_SIGNING_CERT}"
          ]
        }
      }
    ]
  }
}
