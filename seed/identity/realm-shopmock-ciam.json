{
  "realm": "shopmock-ciam",
  "enabled": true,
  "displayName": "ShopMock Customer Identity",
  "sslRequired": "none",
  "registrationAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Default registered customer",
        "composite": true,
        "composites": {
          "client": {
            "storefront": [
              "customer"
            ]
          }
        }
      },
      {
        "name": "seller",
        "description": "Explicit marketplace seller",
        "composite": true,
        "composites": {
          "client": {
            "seller-dashboard": [
              "seller"
            ]
          }
        }
      }
    ],
    "client": {
      "storefront": [
        {
          "name": "customer",
          "description": "May use the storefront as a customer"
        }
      ],
      "seller-dashboard": [
        {
          "name": "seller",
          "description": "May use Seller Central"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "customers",
      "realmRoles": [
        "customer"
      ]
    },
    {
      "name": "sellers",
      "realmRoles": [
        "seller"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "storefront",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "pgrst-role-from-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "storefront",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seller-dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/seller/*",
        "http://localhost/silent-check-sso.html"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "pgrst-role-from-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "seller-dashboard",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
